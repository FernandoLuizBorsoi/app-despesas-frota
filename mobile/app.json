{
  "expo": {
    "name": "Despesas Frota",
    "slug": "despesas-frota",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.com.frota.despesas"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "br.com.frota.despesas"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "cameraPermission": "O app usa a câmera para fotografar os comprovantes das despesas.",
          "photosPermission": "O app acessa suas fotos para anexar comprovantes já fotografados."
        }
      ],
      "expo-secure-store",
      "./plugins/ler-comprovante.js"
    ],
    "scheme": "despesasfrota",
    "owner": "fernandoborsoi",
    "extra": {
      "eas": {
        "projectId": "649d870b-0275-4c72-b445-05bc300e6b8c"
      }
    }
  }
}
